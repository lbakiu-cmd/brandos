generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. BETTER AUTH MODELS
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
}

model Session {
  id           String   @id @default(cuid())
  expiresAt    DateTime
  token        String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ipAddress    String?
  userAgent    String?
  userId       String

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================================
// 2. CORE BUSINESS MODELS
// ==========================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  businesses  Business[]
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(MEMBER)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Business {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  logo           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  websiteUrl     String?
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  postalCode     String?
  category       String?
  description    String?
  openingHours   Json?
  services       Json?

  websites              Website[]
  googleBusinessProfile GoogleBusinessProfile?
  socialProfiles        SocialProfile[]
  visibilityScore       BusinessVisibilityScore?
  recommendations       BusinessRecommendation[]
  tasks                 BusinessTask[]
  scanHistory           BusinessScanHistory[]
  alerts                BusinessAlert[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ==========================================
// 3. WEBSITE & AUDIT MODELS
// ==========================================

model Website {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  url           String
  normalizedUrl String
  domain        String
  isPrimary     Boolean  @default(false)
  scanFrequency WebsiteScanFrequency @default(WEEKLY)
  lastRunAt     DateTime?
  nextRunAt     DateTime?

  crawls        WebsiteCrawl[]
  auditFindings WebsiteAuditFinding[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessId, normalizedUrl])
}

model WebsiteCrawl {
  id           String   @id @default(cuid())
  websiteId    String
  website      Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  status       WebsiteCrawlStatus @default(QUEUED)
  requestedAt  DateTime @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?
  pagesFound   Int?
  pagesCrawled Int?
  data         Json?
  metadata     Json?

  auditFindings WebsiteAuditFinding[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WebsiteAuditFinding {
  id               String   @id @default(cuid())
  websiteId        String
  website          Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  crawlId          String?
  crawl            WebsiteCrawl? @relation(fields: [crawlId], references: [id], onDelete: SetNull)
  
  recommendation   String?

  severity         WebsiteAuditFindingSeverity
  category         WebsiteAuditFindingCategory
  status           WebsiteAuditFindingStatus @default(OPEN)
  code             String
  title            String
  description      String
  impact           String?
  effort           String?
  evidence         Json?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ==========================================
// 4. GOOGLE BUSINESS & SOCIAL MODELS
// ==========================================

model GoogleBusinessProfile {
  id           String   @id @default(cuid())
  businessId   String   @unique
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  status       GoogleBusinessProfileStatus @default(CONNECTED)
  profileUrl   String
  placeId      String?
  businessName String?
  websiteUrl   String?
  phone        String?
  address      String?
  city         String?
  country      String?
  rating       Float?
  reviewCount  Int?
  category     String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SocialProfile {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  platform    SocialProfilePlatform
  status      SocialProfileStatus @default(CONNECTED)
  profileUrl  String
  handle      String?
  displayName String?
  isPrimary   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// 5. SCORES, RECOMMENDATIONS & TASKS
// ==========================================

model BusinessVisibilityScore {
  id           String   @id @default(cuid())
  businessId   String   @unique
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  score        Int      @default(0)
  grade        String?
  summary      String?
  inputs       Json?
  breakdown    Json?
  calculatedAt DateTime @default(now())

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BusinessRecommendation {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  status      BusinessRecommendationStatus @default(OPEN)
  priority    BusinessRecommendationPriority @default(MEDIUM)
  sourceType  BusinessRecommendationSourceType
  code        String
  title       String
  description String
  impact      String?
  actionLabel String?
  evidence    Json?

  tasks         BusinessTask[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, code])
}

model BusinessTask {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recommendationId String?
  recommendation   BusinessRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  status           BusinessTaskStatus @default(TODO)
  priority         BusinessTaskPriority @default(MEDIUM)
  sourceType       BusinessTaskSourceType @default(MANUAL)
  title            String
  description      String?
  dueDate          DateTime?
  completedAt      DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BusinessScanHistory {
  id                  String   @id @default(cuid())
  businessId          String
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  websiteId           String?
  crawlId             String?

  scannedAt           DateTime @default(now())
  overallScore        Int      @default(0)
  websiteFoundation   Int      @default(0)
  aiReadiness         Int      @default(0)
  structuredData      Int      @default(0)
  localAuthority      Int      @default(0)
  socialSignals       Int      @default(0)
  contentQuality      Int      @default(0)
  technicalHealth     Int      @default(0)
  brandAuthority      Int      @default(0)
  recommendationCount Int      @default(0)
  changeEvents        Json?
  score               Int?
  data                Json?

  alerts              BusinessAlert[]

  createdAt           DateTime @default(now())
}

model BusinessAlert {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scanHistoryId String?
  scanHistory   BusinessScanHistory? @relation(fields: [scanHistoryId], references: [id], onDelete: SetNull)

  type          BusinessAlertType
  title         String
  description   String
  message       String?
  eventCode     String
  metadata      Json?
  isRead        Boolean  @default(false)
  readAt        DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==========================================
// 6. ENUMS
// ==========================================

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum WebsiteScanFrequency {
  DAILY
  WEEKLY
  MONTHLY
  NEVER
  MANUAL_ONLY
}

enum BusinessAlertType {
  NEW_REVIEW
  NEW_MENTION
  SCAN_FAILED
  VISIBILITY_DROP
  IMPROVEMENT
  WARNING
  CRITICAL
}

enum WebsiteAuditFindingSeverity {
  HIGH
  MEDIUM
  LOW
  INFO
}

enum WebsiteAuditFindingCategory {
  TECHNICAL_SEO
  LOCAL_SEO
  AEO
  GEO
  ACCESSIBILITY
  PERFORMANCE
  SECURITY
  AI_READINESS
  CONTENT
  STRUCTURED_DATA
}

enum WebsiteAuditFindingStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum WebsiteCrawlStatus {
  QUEUED
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum GoogleBusinessProfileStatus {
  CONNECTED
  DISCONNECTED
  PENDING
  ERROR
  MANUAL_CONNECTED
  VERIFIED
}

enum SocialProfilePlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  WHATSAPP
  MESSENGER
  LINKEDIN
  X
  PINTEREST
  YOUTUBE
  THREADS
  OTHER
}

enum SocialProfileStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  ERROR
  MANUAL_CONNECTED
}

enum BusinessRecommendationStatus {
  OPEN
  DONE
  IGNORED
}

enum BusinessRecommendationPriority {
  HIGH
  MEDIUM
  LOW
}

enum BusinessRecommendationSourceType {
  WEBSITE
  GOOGLE_BUSINESS
  SOCIAL
  AUDIT_FINDING
  AI_VISIBILITY
}

enum BusinessTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  IGNORED
}

enum BusinessTaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum BusinessTaskSourceType {
  RECOMMENDATION
  AUDIT_FINDING
  MANUAL
  AI_COPILOT
  WEBSITE
  GOOGLE_BUSINESS
  SOCIAL
  AI_VISIBILITY
}