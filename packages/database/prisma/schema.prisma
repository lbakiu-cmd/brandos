generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Better Auth owns the definitive user and authentication records. Membership
// remains intentionally unlinked until legacy temporary user IDs are migrated.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  sessions      Session[]
  accounts      Account[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum WebsiteCrawlStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum GoogleBusinessProfileStatus {
  NOT_CONNECTED
  MANUAL_CONNECTED
  VERIFIED
}

enum SocialProfilePlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  YOUTUBE
  X
  OTHER
}

enum SocialProfileStatus {
  MANUAL_CONNECTED
  VERIFIED
  DISCONNECTED
}

enum WebsiteAuditFindingCategory {
  TECHNICAL
  CONTENT
  SCHEMA
  LOCAL_SEO
  AI_VISIBILITY
}

enum WebsiteAuditFindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
}

enum WebsiteAuditFindingStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum BusinessRecommendationSourceType {
  WEBSITE
  GOOGLE_BUSINESS
  SOCIAL
  AUDIT_FINDING
  AI_VISIBILITY
}

enum BusinessRecommendationPriority {
  LOW
  MEDIUM
  HIGH
}

enum BusinessRecommendationStatus {
  OPEN
  DONE
  IGNORED
}

enum BusinessTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  IGNORED
}

enum BusinessTaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum BusinessTaskSourceType {
  WEBSITE
  GOOGLE_BUSINESS
  SOCIAL
  AUDIT_FINDING
  AI_VISIBILITY
  MANUAL
}

enum WebsiteScanFrequency {
  DAILY
  WEEKLY
  MONTHLY
  MANUAL_ONLY
}

enum BusinessAlertType {
  CRITICAL
  WARNING
  IMPROVEMENT
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  memberships Membership[]
  businesses  Business[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(OWNER)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Business {
  id                    String                   @id @default(cuid())
  organizationId        String
  name                  String
  slug                  String
  websiteUrl            String?
  category              String?
  country               String?
  city                  String?
  description           String?
  phone                 String?
  email                 String?
  address               String?
  postalCode            String?
  openingHours          Json?
  services              Json?
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  websites              Website[]
  googleBusinessProfile GoogleBusinessProfile?
  socialProfiles        SocialProfile[]
  visibilityScore       BusinessVisibilityScore?
  recommendations       BusinessRecommendation[]
  tasks                 BusinessTask[]
  scanHistory           BusinessScanHistory[]
  alerts                BusinessAlert[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Website {
  id            String                @id @default(cuid())
  businessId    String
  url           String
  normalizedUrl String
  domain        String
  isPrimary     Boolean               @default(false)
  scanFrequency WebsiteScanFrequency  @default(MANUAL_ONLY)
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  crawls        WebsiteCrawl[]
  auditFindings WebsiteAuditFinding[]
  scanHistory   BusinessScanHistory[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([businessId, normalizedUrl])
  @@index([businessId])
  @@index([domain])
  @@index([businessId, isPrimary])
  @@index([scanFrequency])
  @@index([nextRunAt])
}

model WebsiteCrawl {
  id            String                @id @default(cuid())
  websiteId     String
  status        WebsiteCrawlStatus    @default(QUEUED)
  requestedAt   DateTime              @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  errorMessage  String?
  metadata      Json?
  website       Website               @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  auditFindings WebsiteAuditFinding[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([websiteId])
  @@index([status])
  @@index([websiteId, status])
  @@index([requestedAt])
}

model WebsiteAuditFinding {
  id             String                      @id @default(cuid())
  websiteId      String
  crawlId        String?
  category       WebsiteAuditFindingCategory
  severity       WebsiteAuditFindingSeverity
  status         WebsiteAuditFindingStatus   @default(OPEN)
  code           String
  title          String
  description    String
  recommendation String?
  evidence       Json?
  website        Website                     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  crawl          WebsiteCrawl?               @relation(fields: [crawlId], references: [id], onDelete: SetNull)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([websiteId, code])
  @@index([websiteId])
  @@index([crawlId])
  @@index([status])
  @@index([severity])
  @@index([category])
  @@index([websiteId, status])
}

model GoogleBusinessProfile {
  id           String                      @id @default(cuid())
  businessId   String                      @unique
  profileUrl   String
  placeId      String?
  businessName String?
  address      String?
  city         String?
  country      String?
  phone        String?
  websiteUrl   String?
  status       GoogleBusinessProfileStatus @default(MANUAL_CONNECTED)
  business     Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@index([status])
}

model SocialProfile {
  id          String                @id @default(cuid())
  businessId  String
  platform    SocialProfilePlatform
  profileUrl  String
  handle      String?
  displayName String?
  status      SocialProfileStatus   @default(MANUAL_CONNECTED)
  isPrimary   Boolean               @default(false)
  business    Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([businessId, platform, profileUrl])
  @@index([businessId])
  @@index([businessId, platform])
  @@index([businessId, isPrimary])
  @@index([status])
}

model BusinessVisibilityScore {
  id           String   @id @default(cuid())
  businessId   String   @unique
  score        Int
  grade        String?
  summary      String?
  inputs       Json
  breakdown    Json
  calculatedAt DateTime
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
  @@index([score])
  @@index([calculatedAt])
}

model BusinessRecommendation {
  id          String                           @id @default(cuid())
  businessId  String
  sourceType  BusinessRecommendationSourceType
  priority    BusinessRecommendationPriority
  status      BusinessRecommendationStatus     @default(OPEN)
  code        String
  title       String
  description String
  impact      String?
  actionLabel String?
  evidence    Json?
  business    Business                         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tasks       BusinessTask[]
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, status])
  @@index([priority])
  @@index([sourceType])
}

model BusinessTask {
  id               String                  @id @default(cuid())
  businessId       String
  recommendationId String?
  title            String
  description      String?
  status           BusinessTaskStatus      @default(TODO)
  priority         BusinessTaskPriority
  sourceType       BusinessTaskSourceType
  dueDate          DateTime?
  completedAt      DateTime?
  business         Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recommendation   BusinessRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, priority])
  @@index([recommendationId])
  @@index([sourceType])
  @@index([dueDate])
}

model BusinessScanHistory {
  id                    String   @id @default(cuid())
  businessId            String
  websiteId             String?
  crawlId               String?
  scannedAt             DateTime @default(now())
  overallScore          Int
  websiteFoundation     Int
  aiReadiness           Int
  structuredData        Int
  localAuthority        Int
  brandAuthority        Int
  recommendationCount   Int
  changeEvents          Json
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  website               Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  alerts                BusinessAlert[]
  createdAt             DateTime @default(now())

  @@index([businessId])
  @@index([businessId, scannedAt])
  @@index([websiteId])
  @@index([crawlId])
}

model BusinessAlert {
  id            String            @id @default(cuid())
  businessId    String
  scanHistoryId String?
  type          BusinessAlertType
  title         String
  description   String
  eventCode     String
  metadata      Json?
  readAt        DateTime?
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scanHistory   BusinessScanHistory? @relation(fields: [scanHistoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([type])
  @@index([readAt])
}
