# Database & Cache
DATABASE_URL="postgresql://brandos:brandos_password@localhost:5432/brandos?schema=public"
REDIS_URL="redis://localhost:6379"

# Unified OpenRouter AI (Replaces separate OpenAI, Perplexity, Anthropic & Gemini keys)
OPENROUTER_API_KEY="sk-or-v1-..."
# Optional OpenRouter model overrides:
# OPENROUTER_CHATGPT_MODEL="openai/gpt-4o-mini"
# OPENROUTER_PERPLEXITY_MODEL="perplexity/sonar"
# OPENROUTER_CLAUDE_MODEL="anthropic/claude-3.5-haiku"
# OPENROUTER_GEMINI_MODEL="google/gemini-2.0-flash-001"
# OPENROUTER_BLOG_MODEL="openai/gpt-4o-mini"
# OPENROUTER_GBP_MODEL="google/gemini-2.0-flash-001"

# Legacy / Direct Provider Keys (Used as fallback if OPENROUTER_API_KEY is not set)
OPENAI_API_KEY=""
PERPLEXITY_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Application URLs
API_URL="https://icandothat.online/api"
FRONTEND_URL="https://icandothat.online"
