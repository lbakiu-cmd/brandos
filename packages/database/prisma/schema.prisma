generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enums ----------------

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum IntegrationProvider {
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_ANALYTICS_4
  GOOGLE_BUSINESS_PROFILE
  FACEBOOK_PAGE
  INSTAGRAM_INSIGHTS
  LINKEDIN_COMPANY
  YOUTUBE_ANALYTICS
  WORDPRESS
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
  PENDING
}

enum WidgetCategory {
  POPULAR
  GOOGLE
  SEO
  AI_DISCOVERY
  SOCIAL_ANALYTICS
  REVIEWS
  CUSTOM
}

enum WidgetType {
  GSC_QUERIES_TABLE
  GSC_CLICKS_IMPRESSIONS
  GA4_AI_TRAFFIC
  GA4_TOP_PAGES
  GBP_LOCAL_PERFORMANCE
  GBP_REVIEWS_FEED
  AEO_CITATION_SHARE
  AEO_PROMPT_RANKINGS
  SEO_HEALTH_GAUGE
  WORDPRESS_AIVISION_STATUS
  META_PAGE_REACH
  INSTAGRAM_AUDIENCE
  LINKEDIN_PAGE_STATS
  CUSTOM_METRIC
}

enum AuditStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum RecommendationStatus {
  OPEN
  DONE
  DISMISSED
}

enum SubscriptionTier {
  FREE
  STARTER
  GROWTH
  AGENCY
}

enum AiEngine {
  CHATGPT
  GEMINI
  CLAUDE
  PERPLEXITY
  GOOGLE_AI_OVERVIEW
  BING_COPILOT
}

// ---------------- Identity & Tenancy ----------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Business {
  id        String   @id @default(uuid())
  name      String
  website   String?
  phone     String?
  email     String?
  timezone  String   @default("Europe/Tirane")
  industry  String?
  city      String?
  country   String?
  logoUrl   String?

  // Subscription & Billing
  subscriptionTier     SubscriptionTier @default(FREE)
  subscriptionStatus   String?          @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?

  // WordPress / AIVision SEO Integration
  wordpressUrl           String?
  wordpressApiKey        String?
  wordpressApiSecret     String?
  wordpressConnectedAt   DateTime?
  wordpressLastSyncedAt  DateTime?
  wordpressPluginVersion String?
  wordpressSiteName      String?
  wordpressTelemetry     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         Membership[]
  integrations        IntegrationAccount[]
  widgets             DashboardWidget[]
  metricSnapshots     MetricSnapshot[]
  websiteAudits       WebsiteAudit[]
  gbpAudits           GbpAudit[]
  socialAudits        SocialAudit[]
  aiReports           AiVisibilityReport[]
  recommendations     Recommendation[]
  competitors         Competitor[]
  reviews             GoogleReview[]

  @@map("businesses")
}

model Membership {
  id         String   @id @default(uuid())
  userId     String
  businessId String
  role       Role     @default(MEMBER)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@map("memberships")
}

// ---------------- Connected Accounts & OAuth ----------------

model IntegrationAccount {
  id              String              @id @default(uuid())
  businessId      String
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider        IntegrationProvider
  accountName     String?
  externalId      String?
  avatarUrl       String?
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  scopes          String?
  status          ConnectionStatus    @default(CONNECTED)
  metricsCache    Json?
  lastSyncedAt    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([businessId, provider, externalId])
  @@map("integration_accounts")
}

// ---------------- Modular Dashboard Widgets ----------------

model DashboardWidget {
  id         String         @id @default(uuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  widgetType WidgetType
  title      String
  category   WidgetCategory @default(POPULAR)
  config     Json?
  position   Int            @default(0)
  width      Int            @default(1) // 1, 2, or 3 columns
  height     Int            @default(1)
  enabled    Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([businessId, position])
  @@map("dashboard_widgets")
}

model MetricSnapshot {
  id         String              @id @default(uuid())
  businessId String
  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider   IntegrationProvider
  metricKey  String
  value      Float
  dimensions Json?
  date       DateTime            @default(now())

  @@index([businessId, provider, metricKey, date])
  @@map("metric_snapshots")
}

// ---------------- Reviews & Local Reputation ----------------

model GoogleReview {
  id           String    @id @default(uuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authorName   String
  authorAvatar String?
  rating       Int       @default(5)
  comment      String?
  aiReplyDraft String?
  replyText    String?
  repliedAt    DateTime?
  reviewDate   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([businessId, rating])
  @@map("google_reviews")
}

// ---------------- Intelligence & AI Visibility ----------------

model WebsiteAudit {
  id          String      @id @default(uuid())
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url         String
  score       Int?
  status      AuditStatus @default(QUEUED)
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  createdAt   DateTime    @default(now())

  findings AuditFinding[]

  @@index([businessId, createdAt])
  @@map("website_audits")
}

model AuditFinding {
  id             String       @id @default(uuid())
  auditId        String
  audit          WebsiteAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  category       String
  severity       Severity     @default(MEDIUM)
  title          String
  description    String?
  recommendation String?
  impactPoints   Int          @default(0)
  effortMinutes  Int          @default(0)
  passed         Boolean      @default(false)
  metadata       Json?

  @@index([auditId])
  @@map("audit_findings")
}

model GbpAudit {
  id          String      @id @default(uuid())
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  score       Int?
  metrics     Json?
  status      AuditStatus @default(QUEUED)
  completedAt DateTime?
  createdAt   DateTime    @default(now())

  @@index([businessId, createdAt])
  @@map("gbp_audits")
}

model SocialAudit {
  id          String      @id @default(uuid())
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  score       Int?
  metrics     Json?
  status      AuditStatus @default(QUEUED)
  completedAt DateTime?
  createdAt   DateTime    @default(now())

  @@index([businessId, createdAt])
  @@map("social_audits")
}

model AiVisibilityReport {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  overallScore Int?
  engineScores Json?
  mentions     Json?
  promptsRun   Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("ai_visibility_reports")
}

model Recommendation {
  id              String               @id @default(uuid())
  businessId      String
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceType      String?
  sourceId        String?
  category        String?
  priority        Priority             @default(MEDIUM)
  title           String
  description     String?
  actionType      String?
  actionPayload   Json?
  expectedImpact  Int                  @default(0)
  estimatedEffort Int                  @default(0)
  status          RecommendationStatus @default(OPEN)
  completedAt     DateTime?
  createdAt       DateTime             @default(now())

  @@index([businessId, status])
  @@map("recommendations")
}

model Competitor {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  website    String?
  createdAt  DateTime @default(now())

  mentions CompetitorMention[]

  @@map("competitors")
}

model CompetitorMention {
  id           String     @id @default(uuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  engine       AiEngine
  prompt       String
  mentioned    Boolean    @default(false)
  rank         Int?
  sentiment    String?
  citationUrl  String?
  capturedAt   DateTime   @default(now())

  @@index([competitorId, capturedAt])
  @@map("competitor_mentions")
}