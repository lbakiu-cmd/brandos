 @@map(\"metric_snapshots\")\n}\n\nmodel BusinessSnapshot {\n  id           String       @id @default(uuid())\n  businessId   String\n  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)\n  snapshotType SnapshotType @default(INITIAL_REGISTRATION)\n\n  // Overall scores & rating\n  overallScore Int\n  grade        String\n  gradeLabel   String?\n\n  // Pillar scores (0-100)\n  websiteScore      Int?\n  gbpScore          Int?\n  aiVisibilityScore Int?\n  socialScore       Int?\n\n  // Detailed metrics payload (checks, findings, rankings, breakdown)\n  metrics         Json?\n  findingsSummary Json?\n\n  // 14-day milestone & reminder tracking\n  reminderDate      DateTime?\n  reminderSentAt    DateTime?\n  reminderDismissed Boolean   @default(false)\n\n  capturedAt DateTime @default(now())\n  createdAt  DateTime @default(now())\n  updatedAt  DateTime @updatedAt\n\n  @@index([businessId, snapshotType, capturedAt])\n  @@map(\"business_snapshots\")\n}\n\n// ---------------- Reviews & Local Reputation ----------------\n\nmodel GoogleReview {\n  id           String    @id @default(uuid())\n  businessId   String\n  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)\n  authorName   String\n  authorAvatar String?\n  rating       Int       @default(5)\n  comment      String?\n  aiReplyDraft String?\n  replyText    String?\n  repliedAt    DateTime?\n  reviewDate   DateTime  @default(now())\n  createdAt    DateTime  @default(now())\n  updatedAt    DateTime  @updatedAt\n\n  @@index([businessId, rating])\n  @@map(\"google_reviews\")\n}\n\n// ---------------- Intelligence & AI Visibility ----------------\n\nmodel WebsiteAudit {\n  id          String      @id @default(uuid())\n  businessId  String\n  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)\n  url         String\n  score       Int?\n  status      AuditStatus @default(QUEUED)\n  startedAt   DateTime?\n  completedAt DateTime?\n  error       String?\n  createdAt   DateTime    @default(now())\n\n  findings AuditFinding[]\n\n  @@index([businessId, createdAt])\n  @@map(\"website_audits\")\n}\n\nmodel AuditFinding {\n  id             String       @id @default(uuid())\n  auditId        String\n  audit          WebsiteAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)\n  category       String\n  severity       Severity     @default(MEDIUM)\n  title          String\n  description    String?\n  recommendation String?\n  impactPoints   Int          @default(0)\n  effortMinutes  Int          @default(0)\n  passed         Boolean      @default(false)\n  metadata       Json?\n\n  @@index([auditId])\n  @@map(\"audit_findings\")\n}\n\nmodel GbpAudit {\n  id          String      @id @default(uuid())\n  businessId  String\n  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)\n  score       Int?\n  metrics     Json?\n  status      AuditStatus @default(QUEUED)\n  completedAt DateTime?\n  createdAt   DateTime    @default(now())\n\n  @@index([businessId, createdAt])\n  @@map(\"gbp_audits\")\n}\n\nmodel SocialAudit {\n  id          String      @id @default(uuid())\n  businessId  String\n  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)\n  score       Int?\n  metrics     Json?\n  status      AuditStatus @default(QUEUED)\n  completedAt DateTime?\n  createdAt   DateTime    @default(now())\n\n  @@index([businessId, createdAt])\n  @@map(\"social_audits\")\n}\n\nmodel AiVisibilityReport {\n  id           String   @id @default(uuid())\n  businessId   String\n  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)\n  overallScore Int?\n  engineScores Json?\n  mentions     Json?\n  promptsRun   Int      @default(0)\n  createdAt    DateTime @default(now())\n\n  @@index([businessId, createdAt])\n  @@map(\"ai_visibility_reports\")\n}\n\nmodel Recommendation {\n  id              String               @id @default(uuid())\n  businessId      String\n  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)\n  sourceType      String?\n  sourceId        String?\n  category        String?\n  priority        Priority             @default(MEDIUM)\n  title           String\n  description     String?\n  actionType      String?\n  actionPayload   Json?\n  expectedImpact  Int                  @default(0)\n  estimatedEffort Int                  @default(0)\n  status          RecommendationStatus @default(OPEN)\n  completedAt     DateTime?\n  createdAt       DateTime             @default(now())\n\n  @@index([businessId, status])\n  @@map(\"recommendations\")\n}\n\nmodel Competitor {\n  id         String   @id @default(uuid())\n  businessId String\n  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)\n  name       String\n  website    String?\n  createdAt  DateTime @default(now())\n\n  mentions CompetitorMention[]\n\n  @@map(\"competitors\")\n}\n\nmodel CompetitorMention {\n  id           String     @id @default(uuid())\n  competitorId String\n  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)\n  engine       AiEngine\n  prompt       String\n  mentioned    Boolean    @default(false)\n  rank         Int?\n  sentiment    String?\n  citationUrl  String?\n  capturedAt   DateTime   @default(now())\n\n  @@index([competitorId, capturedAt])\n  @@map(\"competitor_mentions\")\n}\n",
